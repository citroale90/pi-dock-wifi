# Copy to .env and keep private. / Copiare in .env e non pubblicarlo.
# Traduzione / Translation: Copy to .env and keep it private / Copiare in .env e mantenerlo privato
APP_LANGUAGE=it
SSID1=MyRouter
SSID2=MyRouter
WPA_PASSPHRASE1=CHANGE_ME_WIFI_PASSWORD
WPA_PASSPHRASE2=CHANGE_ME_WIFI_PASSWORD
DASHBOARD_PASSWORD=CHANGE_ME_DASHBOARD_PASSWORD
PIHOLE_PASSWORD=CHANGE_ME_PIHOLE_PASSWORD
SSH_USER=pi
SSH_HOST=127.0.0.1
SSH_PASSWORD=CHANGE_ME_SSH_PASSWORD
LOCAL_DOMAIN=home.arpa
PIHOLE_EXTRA_DNS=stop-dns-rebind
EXTRA_ROUTES=
# Set only after identifying the intended devices. Empty disables only these two blocks.
# Traduzione / Translation: Compilare solo dopo avere identificato i dispositivi interessati; valori vuoti disattivano soltanto
# IT/EN: questi due blocchi
ISOLATED_DEVICE_1_IP=
ISOLATED_DEVICE_2_IP=
# Generate once with uuidgen, and use the same UUID for both radios.
# Traduzione / Translation: Generare una sola volta con uuidgen e usare lo stesso UUID per entrambe le radio
WPS_UUID=CHANGE_ME_UUID
# Optional reverse proxy; leave empty for direct LAN access.
# Traduzione / Translation: Reverse proxy opzionale: lasciare vuoto per accesso diretto dalla LAN
TRUSTED_PROXY_IP=
